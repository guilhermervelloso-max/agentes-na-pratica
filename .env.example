# ===== Obrigatórias =====
# Conexão PostgreSQL (Neon, Supabase, Docker local...). Em serviços com pooler, use a URL "pooled" aqui.
DATABASE_URL="postgresql://agentes:agentes@localhost:5432/agentes?schema=public"

# URL pública do site, SEM barra no final. Usada em SEO, sitemap, RSS, Open Graph e nos e-mails.
# Ex.: https://agentes.seudominio.com.br
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Auth.js: segredo para assinar sessões. Gere com: openssl rand -base64 32
AUTH_SECRET="troque-por-um-segredo-longo"
# URL base do Auth.js (igual à do site). AUTH_URL e NEXTAUTH_URL são aceitas.
AUTH_URL="http://localhost:3000"
# Defina "true" atrás de proxy/host que não seja a Vercel (Docker, VPS, etc.)
AUTH_TRUST_HOST="true"

# SMTP para o link mágico do admin (opcional se usar ADMIN_PASSWORD_HASH). Qualquer provedor: Brevo, Mailgun, Zoho, Hostinger Mail...
# Formato: smtp://usuario:senha@host:porta  (porta 465 => use smtps://)
EMAIL_SERVER="smtp://localhost:1025"
EMAIL_FROM="Agentes na Prática <nao-responda@exemplo.com.br>"

# Único e-mail com acesso a /admin (o site público não tem contas)
ADMIN_EMAIL="voce@exemplo.com.br"
# Alternativa ao link mágico: senha do admin (hash). Gere com: npm run admin:hash -- "sua senha"
ADMIN_PASSWORD_HASH=""

# Segredo da rota /api/cron/coletar (enviado como "Authorization: Bearer <segredo>")
CRON_SECRET="troque-por-outro-segredo"

# ===== Opcionais =====
# App "script" do Reddit (https://www.reddit.com/prefs/apps) para a API oficial com OAuth app-only.
# Sem elas o coletor usa os feeds RSS públicos (sem score/comentários).
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
# User-Agent identificável exigido pelo Reddit
REDDIT_USER_AGENT="web:agentes-na-pratica:1.0 (by /u/seu_usuario)"
# E-mail de contato exibido em /apoiar e /privacidade
CONTACT_EMAIL="contato@exemplo.com.br"
